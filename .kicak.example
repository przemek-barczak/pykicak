# Copy this file to .kicak (or a role-specific file such as .kicak.injector)
# and fill in real values. Never commit the real .kicak file.
#
# This file holds RabbitMQ connection details only. Queue, exchange, and binding
# names are application topology, declared in a messaging/ module (see
# examples/poc/messaging/ for an example) and passed to agent constructors in code.

RABBIT_MQ_USERNAME=guest
RABBIT_MQ_PASSWORD=guest
RABBIT_MQ_HOST=localhost
RABBIT_MQ_PORT=5672
RABBIT_MQ_VIRTUAL_HOST=/

# TLS: true encrypts the connection (usually port 5671) and accepts the broker only if its
# certificate is valid, issued by a trusted CA, and names RABBIT_MQ_HOST. false sends the
# credentials and messages unencrypted: use it only for a local or fully trusted network, as here.
RABBIT_MQ_TLS=false

# Optional, with RABBIT_MQ_TLS=true only: trust only the CA certificates in this PEM file, e.g. the
# private CA of a self-hosted broker. Without it, the CAs the operating system trusts are used.
# RABBIT_MQ_CA_FILE=/etc/ssl/rabbitmq/ca.pem
